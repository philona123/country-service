APP_NAME=Country Service
ENVIRONMENT=development
LOG_LEVEL=INFO

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=country_db
MONGODB_TEST_DATABASE=country_db_test

COUNTRY_API_URL=https://www.apicountries.com
INGESTION_INTERVAL_HOURS=1

REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CACHE_NEGATIVE_TTL_SECONDS=60
